# Configuration for OpenClaw LiteRT Bridge Server

# Path to the .litertlm model flatbuffer (defaults to ~/litert-models/models/gemma-4-E2B-it.litertlm)
LITERT_MODEL_PATH=~/litert-models/models/gemma-4-E2B-it.litertlm

# Model ID reported to OpenAI clients
LITERT_MODEL_ID=gemma-4-E2B-it

# Server host and port
HOST=127.0.0.1
PORT=4000
